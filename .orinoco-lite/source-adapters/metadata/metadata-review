#!/usr/bin/env bash
set -euo pipefail

metadata_dir="$(cd "$(dirname "$0")" && pwd -P)"

cleanup_detached_link() {
  status=$?
  trap - EXIT
  if [[ -L "$metadata_dir/.pixi/envs" ]]; then
    unlink "$metadata_dir/.pixi/envs"
  fi
  rmdir "$metadata_dir/.pixi" 2>/dev/null || true
  exit "$status"
}
trap cleanup_detached_link EXIT

pixi \
  run \
  --config-file "$metadata_dir/pixi-config.toml" \
  --manifest-path "$metadata_dir/pixi.toml" \
  "$@"
