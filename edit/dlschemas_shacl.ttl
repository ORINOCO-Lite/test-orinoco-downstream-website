            sh:order 12 ;
            sh:path skos:exactMatch ] ;
    sh:targetClass dlthings:Delegation .

dlthings:File a sh:NodeShape ;
    rdfs:comment "A specific representation of a data item in the form of an electronic file. The concept of a file here is aligned with the broad UNIX philoshopy of \"everything is a file\". An archive, a disk image, a directory are all valid instances of a file." ;
    sh:closed true ;
    sh:ignoredProperties ( dlthings:conforms_to dlthings:quoted_from dlthings:attributed_to dlthings:revision_of dlthings:specialization_of dlthings:derived_from rdf:type dlthings:invalidated_by dlthings:generated_by dlthings:influenced_by dlthings:rules dlthings:alternate_of ) ;
