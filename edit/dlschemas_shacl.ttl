dlthings:Person a sh:NodeShape ;
    rdfs:comment "Person agents are people, alive, dead, or fictional." ;
    sh:closed true ;
    sh:ignoredProperties ( dlthings:depiction rdf:type dlthings:nickname dlthings:influenced_by dlthings:delegated_by ) ;
    sh:property [ dash:singleLine false ;
