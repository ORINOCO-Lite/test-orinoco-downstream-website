            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path dlthings:invalidated_by ],
        [ sh:class xyzri:XYZInstrumentType ;
            sh:description "The type of this instrument, e.g. microscope, software, chainsaw" ;
