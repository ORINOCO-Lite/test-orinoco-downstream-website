        [ sh:description "A list of terms from different schemas or terminology systems that have narrower meaning." ;
            sh:name "Narrow mappings" ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path skos:narrowMatch ],
        [ sh:class dlthings:Thing ;
