            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path rdf:object ],
        [ sh:class dlthings:Thing ;
            sh:description "The nature of the subject." ;
            sh:maxCount 1 ;
            sh:name "Kind" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path dcterms:type ] ;
    sh:targetClass dlthings:Invalidation .

