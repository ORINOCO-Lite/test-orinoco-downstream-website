            sh:order 18 ;
            sh:path dlthings:characterized_by ],
        [ sh:class dlthings:Thing ;
            sh:description "The nature of the subject." ;
            sh:maxCount 1 ;
            sh:name "Kind" ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
