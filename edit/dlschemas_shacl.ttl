        [ sh:class dlthings:Thing ;
            sh:description "Reference to a `Thing` within a `Statement`." ;
            sh:maxCount 1 ;
            sh:name "Agent" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
