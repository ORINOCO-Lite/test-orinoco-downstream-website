            sh:name "Record display note" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path skos:note ],
        [ sh:class dlthings:Thing ;
            sh:description "A relation of an information artifact to the subject, such as a URL identifying the topic of a document." ;
            sh:maxCount 1 ;
            sh:name "About" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
