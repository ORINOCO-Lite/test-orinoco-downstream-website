dlthings:Subject a sh:NodeShape ;
    rdfs:comment "A subject is an entity being investigated in a study. This is a contextual entity. One and the same entity can be different subjects in two different studies." ;
    sh:closed true ;
    sh:ignoredProperties ( dlthings:quoted_from dlthings:attributed_to dlthings:revision_of dlthings:specialization_of dlthings:derived_from rdf:type dlthings:generated_by dlthings:invalidated_by dlthings:influenced_by dlthings:rules dlthings:alternate_of ) ;
    sh:property [ sh:description "A list of terms from different schemas or terminology systems that have narrower meaning." ;
            sh:name "Narrow mappings" ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path skos:narrowMatch ],
