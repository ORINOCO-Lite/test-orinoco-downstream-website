        [ sh:description "A list of terms from different schemas or terminology systems that have related meaning." ;
            sh:name "Related mappings" ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path skos:relatedMatch ],
        [ sh:datatype xsd:string ;
